{
  "name": "@crazy-cash/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "guest:cleanup": "tsx src/jobs/guest-cleanup.ts",
    "ton:deposit-watcher": "tsx src/jobs/ton-deposit-watcher.ts",
    "ton:withdrawal-worker": "tsx src/jobs/ton-withdrawal-worker.ts",
    "ton:testnet-recipient": "tsx src/scripts/testnet-recipient.ts",
    "ton:testnet-deposit-transfer": "tsx src/scripts/testnet-deposit-transfer.ts",
    "lint": "echo 'lint not configured yet'"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
