generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AccountType {
  guest
  telegram
}

/// TON Connect uses these exact chain identifiers: testnet is -3, mainnet is
/// -239. The enum prevents a wallet proof from being silently relabelled.
enum TonNetwork {
  testnet
  mainnet
}

/// Append-only accounting reasons. `amount` is signed canonical TON units;
/// every entry also records the resulting cached balance for reconciliation.
///
/// Withdrawals use a reserve model: `withdrawal_hold` decreases the available
/// balance before an on-chain payout is attempted; `withdrawal_release` returns
/// that same amount only when the payout is safely cancelled or failed. A
/// finalized payout adds no second debit entry, otherwise the hold would be
/// counted twice.
enum LedgerEntryKind {
  deposit_credit
  spin_bet
  spin_payout
  withdrawal_hold
  withdrawal_release
}

enum DepositStatus {
  pending
  observed
  credited
  expired
  rejected
}

enum WithdrawalStatus {
  requested
  held
  sent
  finalized
  failed
  cancelled
}

/// A durable acknowledgement for a command received from a browser or Mini
/// App. A lost HTTP response must not make the client guess whether the server
/// committed the balance mutation. Future TON deposits and withdrawals use the
/// same idempotency contract, while their domain records remain the source of
/// settlement details.
enum ClientOperationType {
  fun_credit_claim
  ton_deposit
  ton_withdrawal
}

enum ClientOperationStatus {
  completed
  rejected
  processing
  failed
}

model User {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique(map: "uq_users_uuid") @db.Char(36)
  accountType    AccountType @default(guest) @map("account_type")
  telegramId     BigInt?     @unique(map: "uq_users_telegram_id") @map("telegram_id")
  telegramPhotoUrl String?   @map("telegram_photo_url") @db.VarChar(2048)
  guestExpiresAt DateTime?   @map("guest_expires_at") @db.DateTime(3)
  email          String?     @unique(map: "uq_users_email") @db.VarChar(255)
  username       String?     @db.VarChar(64)
  passwordHash   String?     @map("password_hash") @db.VarChar(255)
  funBalance     BigInt      @default(1000) @map("fun_balance")
  realBalance    BigInt      @default(0) @map("real_balance")
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  funSpins       FunSpin[]
  realSpins      RealSpin[]
  sessions       Session[]
  wallets        Wallet[]
  tonProofChallenges TonProofChallenge[]
  ledgerEntries  LedgerEntry[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  clientOperations ClientOperation[]

  @@map("users")
}

/// `result` contains a public, JSON-safe response payload (all amounts are
/// strings). It lets a client repeat `GET /crazy-cash/operations/:id` after a
/// timed-out POST and receive the exact terminal outcome without replaying a
/// balance mutation.
model ClientOperation {
  id                 BigInt                @id @default(autoincrement())
  uuid               String                @unique(map: "uq_client_operations_uuid") @db.Char(36)
  userId             Int                   @map("user_id")
  type               ClientOperationType
  idempotencyKey     String                @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                @map("request_fingerprint") @db.Char(64)
  status             ClientOperationStatus
  errorCode          String?               @map("error_code") @db.VarChar(64)
  result             Json?
  completedAt        DateTime?             @map("completed_at") @db.DateTime(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_client_operations_user_id")
  deposit Deposit?

  @@unique([userId, type, idempotencyKey], map: "uq_client_operations_user_id_type_idempotency_key")
  @@index([userId, createdAt], map: "ix_client_operations_user_id_created_at")
  @@index([status, createdAt], map: "ix_client_operations_status_created_at")
  @@map("client_operations")
}

/// Immutable aggregate, deliberately without a foreign key to users: guest
/// operational rows may be deleted while analytics remains available.
model PlayerStatistics {
  id              BigInt      @id @default(autoincrement())
  sourceUserUuid  String      @unique(map: "uq_player_statistics_source_user_uuid") @map("source_user_uuid") @db.Char(36)
  accountType     AccountType @map("account_type")
  telegramId      BigInt?     @map("telegram_id")
  firstIp         String?     @map("first_ip") @db.VarChar(45)
  firstSeenAt     DateTime    @map("first_seen_at") @db.DateTime(3)
  lastSeenAt      DateTime    @map("last_seen_at") @db.DateTime(3)
  guestDeletedAt  DateTime?   @map("guest_deleted_at") @db.DateTime(3)
  funSpinsCount   BigInt      @default(0) @map("fun_spins_count")
  funWagered      BigInt      @default(0) @map("fun_wagered")
  funPayout       BigInt      @default(0) @map("fun_payout")
  realSpinsCount  BigInt      @default(0) @map("real_spins_count")
  realWagered     BigInt      @default(0) @map("real_wagered")
  realPayout      BigInt      @default(0) @map("real_payout")
  lastFunSpinAt   DateTime?   @map("last_fun_spin_at") @db.DateTime(3)
  lastRealSpinAt  DateTime?   @map("last_real_spin_at") @db.DateTime(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([accountType, firstSeenAt], map: "ix_player_statistics_account_type_first_seen_at")
  @@index([telegramId], map: "ix_player_statistics_telegram_id")
  @@map("player_statistics")
}

model Session {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique(map: "uq_sessions_uuid") @db.Char(36)
  tokenHash   String    @unique(map: "uq_sessions_token_hash") @map("token_hash") @db.Char(64)
  userId      Int       @map("user_id")
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(3)
  createdIp   String?   @map("created_ip") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sessions_user_id")
  tonProofChallenges TonProofChallenge[]

  @@index([userId, expiresAt], map: "ix_sessions_user_id_expires_at")
  @@index([expiresAt], map: "ix_sessions_expires_at")
  @@map("sessions")
}

/// A wallet becomes usable only after a successfully verified TON Connect
/// proof. The raw address is canonical (workchain:hash) and unique globally.
model Wallet {
  id             BigInt     @id @default(autoincrement())
  uuid           String     @unique(map: "uq_wallets_uuid") @db.Char(36)
  userId         Int        @map("user_id")
  rawAddress     String     @unique(map: "uq_wallets_raw_address") @map("raw_address") @db.VarChar(80)
  publicKey      String     @map("public_key") @db.Char(64)
  network        TonNetwork
  verifiedAt     DateTime   @map("verified_at") @db.DateTime(3)
  disconnectedAt DateTime?  @map("disconnected_at") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_wallets_user_id")
  deposits    Deposit[]
  withdrawals Withdrawal[]

  @@unique([userId, network], map: "uq_wallets_user_id_network")
  @@index([userId, verifiedAt], map: "ix_wallets_user_id_verified_at")
  @@map("wallets")
}

/// Short-lived, single-use server challenges for TON Connect `ton_proof`.
/// They are bound to the current HttpOnly-cookie session, never to body input.
model TonProofChallenge {
  id        BigInt    @id @default(autoincrement())
  payload   String    @unique(map: "uq_ton_proof_challenges_payload") @db.Char(64)
  sessionId BigInt    @map("session_id")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ton_proof_challenges_session_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ton_proof_challenges_user_id")

  @@index([sessionId, expiresAt], map: "ix_ton_proof_challenges_session_id_expires_at")
  @@index([expiresAt], map: "ix_ton_proof_challenges_expires_at")
  @@map("ton_proof_challenges")
}

/// Immutable source of truth for REAL balance movement. `users.real_balance`
/// remains a transactionally maintained cache, not the audit record itself.
model LedgerEntry {
  id             BigInt          @id @default(autoincrement())
  uuid           String          @unique(map: "uq_ledger_entries_uuid") @db.Char(36)
  userId         Int             @map("user_id")
  kind           LedgerEntryKind
  amount         BigInt
  balanceAfter   BigInt          @map("balance_after")
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(128)
  referenceUuid  String?         @map("reference_uuid") @db.Char(36)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ledger_entries_user_id")

  @@unique([userId, idempotencyKey], map: "uq_ledger_entries_user_id_idempotency_key")
  @@index([userId, createdAt], map: "ix_ledger_entries_user_id_created_at")
  @@map("ledger_entries")
}

/// Deposit intents are not credits. A worker may mark an intent credited only
/// after a unique, finalized chain transaction has been verified.
model Deposit {
  id                 BigInt        @id @default(autoincrement())
  uuid               String        @unique(map: "uq_deposits_uuid") @db.Char(36)
  userId             Int           @map("user_id")
  walletId           BigInt        @map("wallet_id")
  clientOperationId  BigInt?       @unique(map: "uq_deposits_client_operation_id") @map("client_operation_id")
  network            TonNetwork
  expectedAmount     BigInt        @map("expected_amount")
  receivedAmount     BigInt?       @map("received_amount")
  status             DepositStatus @default(pending)
  transactionHash    String?       @map("transaction_hash") @db.VarChar(128)
  transactionLt      String?       @map("transaction_lt") @db.VarChar(32)
  expiresAt          DateTime      @map("expires_at") @db.DateTime(3)
  observedAt         DateTime?     @map("observed_at") @db.DateTime(3)
  creditedAt         DateTime?     @map("credited_at") @db.DateTime(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_deposits_user_id")
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_deposits_wallet_id")
  clientOperation ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_deposits_client_operation_id")

  @@unique([network, transactionHash, transactionLt], map: "uq_deposits_network_transaction_hash_lt")
  @@index([userId, createdAt], map: "ix_deposits_user_id_created_at")
  @@index([status, expiresAt], map: "ix_deposits_status_expires_at")
  @@map("deposits")
}

/// The watcher records its latest successfully scanned recipient transaction.
/// It deliberately keeps the recipient address in the business key so a
/// future recipient rotation cannot mix two independent histories.
model TonChainCheckpoint {
  id                  BigInt     @id @default(autoincrement())
  network             TonNetwork
  recipientAddress    String     @map("recipient_address") @db.VarChar(80)
  transactionHash     String?    @map("transaction_hash") @db.VarChar(128)
  transactionLt       String?    @map("transaction_lt") @db.VarChar(32)
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([network, recipientAddress], map: "uq_ton_chain_checkpoints_network_recipient")
  @@map("ton_chain_checkpoints")
}

model Withdrawal {
  id             BigInt           @id @default(autoincrement())
  uuid           String           @unique(map: "uq_withdrawals_uuid") @db.Char(36)
  userId         Int              @map("user_id")
  walletId       BigInt           @map("wallet_id")
  network        TonNetwork
  amount         BigInt
  status         WithdrawalStatus @default(requested)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  transactionHash String?         @map("transaction_hash") @db.VarChar(128)
  transactionLt   String?         @map("transaction_lt") @db.VarChar(32)
  heldAt         DateTime?        @map("held_at") @db.DateTime(3)
  observedAt     DateTime?        @map("observed_at") @db.DateTime(3)
  finalizedAt    DateTime?        @map("finalized_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_withdrawals_user_id")
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_withdrawals_wallet_id")

  @@unique([userId, idempotencyKey], map: "uq_withdrawals_user_id_idempotency_key")
  @@unique([network, transactionHash, transactionLt], map: "uq_withdrawals_network_transaction_hash_lt")
  @@index([userId, createdAt], map: "ix_withdrawals_user_id_created_at")
  @@index([status, createdAt], map: "ix_withdrawals_status_created_at")
  @@map("withdrawals")
}

model FunSpin {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique(map: "uq_fun_spins_uuid") @db.Char(36)
  requestId    String   @map("request_id") @db.VarChar(128)
  userId       Int      @map("user_id")
  bet          BigInt
  combination  String   @db.Char(3)
  rule         String   @db.VarChar(64)
  multiplier   Int      @db.UnsignedSmallInt
  payout       BigInt
  balanceAfter BigInt   @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fun_spins_user_id")

  @@unique([userId, requestId], map: "uq_fun_spins_user_id_request_id")
  @@index([userId, createdAt], map: "ix_fun_spins_user_id_created_at")
  @@map("fun_spins")
}

model RealSpin {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique(map: "uq_real_spins_uuid") @db.Char(36)
  requestId    String   @map("request_id") @db.VarChar(128)
  denomination String   @default("0.01") @db.VarChar(4)
  userId       Int      @map("user_id")
  bet          BigInt
  combination  String   @db.Char(3)
  rule         String   @db.VarChar(64)
  multiplier   Int      @db.UnsignedSmallInt
  payout       BigInt
  balanceAfter BigInt   @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_real_spins_user_id")

  @@unique([userId, requestId], map: "uq_real_spins_user_id_request_id")
  @@index([userId, createdAt], map: "ix_real_spins_user_id_created_at")
  @@map("real_spins")
}
