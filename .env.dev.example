# Shared
TZ=Asia/Bangkok

# API
API_PORT=51935
API_ORIGIN=http://localhost:20069
DEV_API_RESPONSE_DELAY_MS=0

# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
MYSQL_DATABASE=crazy_cash
MYSQL_USER=crazy_cash_user
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
MYSQL_PORT=39266
DATABASE_URL=mysql://crazy_cash_user:CHANGE_ME_LOCAL_DATABASE_PASSWORD@localhost:39266/crazy_cash

# phpMyAdmin
PMA_PORT=38114

# Frontend
WEB_PORT=20069
VITE_API_BASE_URL=http://localhost:51935
VITE_TG_BOT_NAME=CHANGE_ME
VITE_TON_MANIFEST_URL=http://localhost:20069/tonconnect-manifest.json
VITE_ENABLE_TONCONNECT=1

# Telegram Bot
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# TON network and RPC
TON_NETWORK=testnet
TON_RPC_TESTNET_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TONCENTER_TESTNET_API_KEY=CHANGE_ME
TON_RPC_MAINNET_URL=https://toncenter.com/api/v2/jsonRPC
TONCENTER_MAINNET_API_KEY=CHANGE_ME

# TON Connect proof
TON_PROOF_DOMAIN=CHANGE_ME
TON_PROOF_CHALLENGE_TTL_SECONDS=600
TON_PROOF_MAX_AGE_SECONDS=600

# TON Deposits (10000 UN = 10 TON)
TON_DEPOSIT_RECIPIENT_TESTNET=CHANGE_ME
TON_DEPOSIT_RECIPIENT_MAINNET=CHANGE_ME
TON_DEPOSIT_TTL_SECONDS=1800
TON_DEPOSIT_MAX_UNITS=10000
TON_DEPOSIT_FINALITY_SECONDS=5
TON_DEPOSIT_WATCHER_INTERVAL_SECONDS=3
TON_DEPOSIT_ENABLE_MAINNET=0

# TON Withdrawals (10000 UN = 10 TON)
TON_WITHDRAW_SENDER_TESTNET=CHANGE_ME
TON_WITHDRAW_SENDER_MAINNET=CHANGE_ME
TON_WITHDRAW_MIN_UNITS=100
TON_WITHDRAW_MAX_UNITS=10000
TON_WITHDRAW_FINALITY_SECONDS=15
TON_WITHDRAW_WATCHER_INTERVAL_SECONDS=5
TON_WITHDRAW_ENABLE_TESTNET=0
TON_WITHDRAW_ENABLE_MAINNET=0

# TON mnemonics: host directory and Docker container paths (outside Git).
# The host directory uses mode 0700; each mnemonic uses mode 0600.
TON_SECRETS_DIR=/your_server_folder
TON_TESTNET_DEPOSIT_MNEMONIC_FILE=/run/secrets/testnet-deposit-recipient.mnemonic
TON_TESTNET_WITHDRAW_MNEMONIC_FILE=/run/secrets/testnet-withdraw-sender.mnemonic
TON_MAINNET_WITHDRAW_MNEMONIC_FILE=/run/secrets/mainnet-withdraw-sender.mnemonic

# Session
GUEST_FUN_START_BALANCE=1000
GUEST_ACCOUNT_TTL_HOURS=24
SESSION_TTL_HOURS=24
