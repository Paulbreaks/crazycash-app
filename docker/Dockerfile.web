FROM node:26-alpine AS build

WORKDIR /workspace

RUN npm install --global pnpm@10.33.2

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --filter @crazy-cash/web... --frozen-lockfile

COPY apps/web apps/web
COPY packages/shared packages/shared

ARG VITE_API_BASE_URL
ARG VITE_TG_BOT_NAME
ARG VITE_TON_MANIFEST_URL
ARG VITE_ENABLE_TONCONNECT=0

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
  VITE_TG_BOT_NAME=$VITE_TG_BOT_NAME \
  VITE_TON_MANIFEST_URL=$VITE_TON_MANIFEST_URL \
  VITE_ENABLE_TONCONNECT=$VITE_ENABLE_TONCONNECT

RUN pnpm --filter @crazy-cash/web build

FROM nginx:stable-alpine AS runtime

COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html

# Godot Web runtime — крупнейшая часть первой загрузки. Готовим gzip заранее:
# nginx отдаёт .wasm/.pck с Content-Encoding: gzip без нагрузки на CPU VPS.
# Исходные файлы остаются рядом как fallback для клиентов без gzip.
RUN gzip -9 -k /usr/share/nginx/html/godot/index.wasm \
  && gzip -9 -k /usr/share/nginx/html/godot/index.pck

EXPOSE 8080
