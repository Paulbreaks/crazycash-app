FROM node:26-alpine AS build

WORKDIR /workspace

RUN npm install --global pnpm@10.33.2

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --filter @crazy-cash/api... --frozen-lockfile

COPY apps/api apps/api
COPY packages/shared packages/shared

# Prisma generate reads the URL schema but does not contact this placeholder DB.
ENV DATABASE_URL=mysql://placeholder:placeholder@localhost:3306/placeholder
RUN pnpm --filter @crazy-cash/api prisma:generate \
  && pnpm --filter @crazy-cash/api build

FROM node:26-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /workspace/node_modules /app/node_modules
COPY --from=build /workspace/apps/api /app/apps/api

USER node
EXPOSE 3000

CMD ["/bin/sh", "-ec", "/app/apps/api/node_modules/.bin/prisma migrate deploy --config apps/api/prisma7.config.ts && node apps/api/dist/server.js"]
