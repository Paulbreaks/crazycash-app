{
  "name": "crazy-cash",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @crazy-cash/api test",
    "docker:dev:up": "docker compose --env-file .env.dev -f docker/compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file .env.dev -f docker/compose.dev.yml down",
    "docker:prod:up": "docker compose --env-file .env.prod -f docker/compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker/compose.prod.yml down"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "pnpm": {
    "overrides": {
      "valibot": "1.4.2"
    }
  }
}
